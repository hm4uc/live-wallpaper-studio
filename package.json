{
  "name": "live-wallpaper-studio",
  "displayName": "Live Wallpaper Studio",
  "description": "%description%",
  "version": "1.1.4",
  "publisher": "derekhoang",
  "license": "MIT",
  "icon": "media/icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "background",
    "wallpaper",
    "live wallpaper",
    "gif",
    "video",
    "pixel",
    "theme",
    "vscode",
    "antigravity"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "wallpaperStudio",
          "title": "%view.picker%",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "views": {
      "wallpaperStudio": [
        {
          "type": "webview",
          "id": "wallpaperStudio.picker",
          "name": "%view.picker%",
          "icon": "media/panel-icon.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "wallpaperStudio.open",
        "title": "%command.open%",
        "category": "%category%",
        "icon": "$(file-media)"
      },
      {
        "command": "wallpaperStudio.next",
        "title": "%command.next%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.prev",
        "title": "%command.prev%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.random",
        "title": "%command.random%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.toggle",
        "title": "%command.toggle%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.quickMenu",
        "title": "%command.quickMenu%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.addFiles",
        "title": "%command.addFiles%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.addFromUrl",
        "title": "%command.addFromUrl%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.openLibraryFolder",
        "title": "%command.openLibraryFolder%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.setRotation",
        "title": "%command.setRotation%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.optimizeHeavy",
        "title": "%command.optimizeHeavy%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.setWorkspaceWallpaper",
        "title": "%command.setWorkspaceWallpaper%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.clearWorkspaceWallpaper",
        "title": "%command.clearWorkspaceWallpaper%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.install",
        "title": "%command.install%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.uninstall",
        "title": "%command.uninstall%",
        "category": "%category%"
      },
      {
        "command": "wallpaperStudio.status",
        "title": "%command.status%",
        "category": "%category%"
      }
    ],
    "keybindings": [
      {
        "command": "wallpaperStudio.open",
        "key": "ctrl+alt+w",
        "mac": "ctrl+alt+w"
      },
      {
        "command": "wallpaperStudio.next",
        "key": "ctrl+alt+]",
        "mac": "ctrl+alt+]"
      },
      {
        "command": "wallpaperStudio.prev",
        "key": "ctrl+alt+[",
        "mac": "ctrl+alt+["
      },
      {
        "command": "wallpaperStudio.toggle",
        "key": "ctrl+alt+0",
        "mac": "ctrl+alt+0"
      }
    ],
    "configuration": {
      "title": "Live Wallpaper Studio",
      "properties": {
        "wallpaperStudio.libraryPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.libraryPath%"
        },
        "wallpaperStudio.ffmpegPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "%config.ffmpegPath%"
        },
        "wallpaperStudio.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "%config.statusBar%"
        },
        "wallpaperStudio.autoRepair": {
          "type": "boolean",
          "default": true,
          "description": "%config.autoRepair%"
        },
        "wallpaperStudio.language": {
          "type": "string",
          "enum": [
            "auto",
            "en",
            "vi"
          ],
          "enumDescriptions": [
            "%config.language.auto%",
            "English",
            "Tiếng Việt"
          ],
          "default": "auto",
          "markdownDescription": "%config.language%"
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "package": "npm run typecheck && npm run build && vsce package --no-dependencies --readme-path README.marketplace.md",
    "vscode:uninstall": "node ./dist/uninstall.js",
    "release:patch": "npm version patch -m \"Release v%s\" && git push --follow-tags",
    "release:minor": "npm version minor -m \"Release v%s\" && git push --follow-tags",
    "release:major": "npm version major -m \"Release v%s\" && git push --follow-tags"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.25.0",
    "ovsx": "^1.4.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hm4uc/live-wallpaper-studio.git"
  },
  "homepage": "https://github.com/hm4uc/live-wallpaper-studio#readme",
  "bugs": {
    "url": "https://github.com/hm4uc/live-wallpaper-studio/issues"
  },
  "galleryBanner": {
    "color": "#151640",
    "theme": "dark"
  }
}
